        <!-- Schools -->
        <record id="school_mn_hoa_sen" model="res.partner">
            <field name="name">Truong Mam non Hoa Sen</field>
            <field name="is_school" eval="True"/>
            <field name="school_type">kindergarten</field>
            <field name="address">12 Duong Nguyen Huu Canh</field>
            <field name="district">Binh Thanh</field>
            <field name="province">TP Ho Chi Minh</field>
            <field name="region">hcm</field>
            <field name="sale_user_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
        </record>
        <record id="school_th_song_tien" model="res.partner">
            <field name="name">Truong Tieu hoc Song Tien</field>
            <field name="is_school" eval="True"/>
            <field name="school_type">primary</field>
            <field name="address">45 Duong Le Loi</field>
            <field name="district">Ninh Kieu</field>
            <field name="province">Can Tho</field>
            <field name="region">mekong</field>
            <field name="sale_user_ids" eval="[(6, 0, [ref('base.user_admin'), ref('base.user_root')])]"/>
        </record>
        <record id="school_thcs_huong_giang" model="res.partner">
            <field name="name">Truong THCS Huong Giang</field>
            <field name="is_school" eval="True"/>
