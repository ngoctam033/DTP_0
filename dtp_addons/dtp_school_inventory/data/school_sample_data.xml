            <field name="address">18 Duong Hung Vuong</field>
            <field name="district">Phu Nhuan</field>
            <field name="province">Hue</field>
            <field name="region">hue</field>
            <field name="sale_user_ids" eval="[(6, 0, [ref('base.user_root')])]"/>
        </record>

