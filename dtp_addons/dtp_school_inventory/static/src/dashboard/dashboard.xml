<?xml version="1.0" encoding="UTF-8"?>
<!--
    Dashboard root template.
    Composes FilterPanel + KpiCards + chart visuals + table.
    Each visual section is self-contained and reads from `state`.
-->
<templates xml:space="preserve">
<t t-name="dtp_school_inventory.Dashboard">
    <div class="dtp-dashboard">

        <!-- ── Header ─────────────────────────────────────────── -->
        <div class="dtp-dashboard-header">
            <div class="dtp-dashboard-title">
                <i class="fa fa-bar-chart me-2"/>
                <span>Inventory Dashboard – Quản lý Dụng cụ Học tập DTP - STEAM</span>
            </div>
            <button class="btn btn-sm btn-outline-dark" t-on-click="onResetFilters">
                <i class="fa fa-refresh me-1"/> Đặt lại bộ lọc
            </button>
        </div>

        <!-- ── Filter Panel (PowerBI-style context slicer) ──────── -->
        <FilterPanel
            options="state.filter_options"
            filters="state.filters"
            onFilterChange.bind="onFilterChange"
        />

        <!-- ── Loading overlay ───────────────────────────────────── -->
        <div t-if="state.loading" class="dtp-loading-overlay">
            <i class="fa fa-spinner fa-spin fa-2x"/>
            <span class="ms-2">Đang tải dữ liệu…</span>
        </div>

        <!-- ── Main content ───────────────────────────────────────── -->
        <div t-if="!state.loading" class="dtp-dashboard-body">

            <!-- Row 1: KPI cards -->
            <div class="dtp-kpi-row">
                <KpiCard
                    label="'Trường học'"
                    value="state.kpis.total_schools"
                    icon="'fa-school'"
                    colorClass="'kpi-blue'"
                    clickable="true"
                    onCardClick.bind="() => this.onKpiClick('res.partner')"
                />
                <KpiCard
                    label="'Lớp học'"
                    value="state.kpis.total_classes"
                    icon="'fa-graduation-cap'"
                    colorClass="'kpi-teal'"
                    clickable="true"
                    onCardClick.bind="() => this.onKpiClick('res.partner.class')"
                />
                <KpiCard
                    label="'Phiếu chờ xử lý'"
                    value="state.kpis.pending_pickings"
                    icon="'fa-clock-o'"
                    colorClass="'kpi-amber'"
                    clickable="true"
                    onCardClick.bind="() => this.onKpiClick('stock.picking', [['state', 'in', ['confirmed', 'waiting', 'assigned']]])"
                />
                <KpiCard
                    label="'Phiếu nháp'"
                    value="state.kpis.draft_pickings"
                    icon="'fa-file-o'"
                    colorClass="'kpi-gray'"
                    clickable="true"
                    onCardClick.bind="() => this.onKpiClick('stock.picking', [['state', '=', 'draft']])"
                />
                <KpiCard
                    label="'Phiếu trễ hạn'"
                    value="state.kpis.late_pickings"
                    icon="'fa-exclamation-triangle'"
                    colorClass="'kpi-red'"
                    clickable="true"
                    onCardClick.bind="() => this.onKpiClick('stock.picking', [['state', 'in', ['confirmed', 'waiting', 'assigned']], ['scheduled_date', '&lt;=', this._now]])"
                />
            </div>

            <!-- Row 2: Donut + Top Products bar -->
            <div class="dtp-chart-row">
                <div class="dtp-chart-card dtp-chart-card--half">
                    <div class="dtp-card-header">Phiếu kho theo Trạng thái</div>
                    <DonutChart
                        data="state.pickings_by_state"
                        labelKey="'label'"
                        valueKey="'count'"
                        onSliceClick.bind="(item) => this.onKpiClick('stock.picking', [['state', '=', item.state]])"
                    />
                </div>
                <div class="dtp-chart-card dtp-chart-card--half">
                    <div class="dtp-card-header">Top 8 Sản phẩm đã xuất</div>
                    <HorizontalBarChart
                        data="state.top_products"
                        labelKey="'product_name'"
                        valueKey="'qty'"
                    />
                </div>
            </div>

            <!-- Row 3: Trend line -->
            <div class="dtp-chart-row">
                <div class="dtp-chart-card dtp-chart-card--full">
                    <div class="dtp-card-header">Xu hướng Phiếu hoàn thành (6 tháng gần nhất)</div>
                    <TrendLineChart
                        data="state.pickings_trend"
                        labelKey="'month'"
                        valueKey="'count'"
                    />
                </div>
            </div>

            <!-- Row 4: Schools overview table -->
            <div class="dtp-chart-row">
                <div class="dtp-chart-card dtp-chart-card--full">
                    <div class="dtp-card-header">Tổng quan Trường học</div>
                    <SchoolsTable
                        rows="state.schools_overview"
                        onRowClick.bind="onSchoolClick"
                    />
                </div>
            </div>

        </div><!-- /dtp-dashboard-body -->
    </div><!-- /dtp-dashboard -->
</t>
</templates>
