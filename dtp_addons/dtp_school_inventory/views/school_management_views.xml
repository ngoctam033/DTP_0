<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtp_school_search" model="ir.ui.view">
        <field name="name">res.partner.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Truong hoc">
                <field name="name"/>
                <field name="school_type"/>
                <field name="region"/>
                <group>
                    <filter name="group_school_type" string="Loai truong" domain="[]" context="{'group_by': 'school_type'}"/>
                    <filter name="group_region" string="Khu vuc" domain="[]" context="{'group_by': 'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dtp_school_list" model="ir.ui.view">
        <field name="name">res.partner.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="school_type"/>
                <field name="address"/>
                <field name="district"/>
                <field name="province"/>
                <field name="region"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="school_type"/>
                            <field name="region"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="district"/>
                            <field name="province"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nhan vien kinh doanh">
                            <field name="sale_user_ids" widget="many2many_tags" options="{'no_create_edit': True}" domain="[('share', '=', False)]"/>
                        </page>
                        <page string="Lop hoc">
                            <field name="class_ids">
                                <list editable="bottom">
                                    <field name="grade"/>
                                    <field name="class_count"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="grade"/>
                                            <field name="class_count"/>
                                        </group>
                                        <notebook>
                                            <page string="Mon hoc">
                                                <field name="subject_ids">
                                                    <list editable="bottom">
                                                        <field name="name"/>
                                                        <field name="supply_product_ids" widget="many2many_tags"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dtp_school" model="ir.actions.act_window">
        <field name="name">Quan ly truong hoc</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dtp_school_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_dtp_school_form')}),
        ]"/>
        <field name="search_view_id" ref="view_dtp_school_search"/>
        <field name="domain">[('is_school', '=', True)]</field>
    </record>

    <!-- Task_9: inherit stock picking form to filter partner_id domain by picking type -->
    <record id="view_picking_form_school_domain" model="ir.ui.view">
        <field name="name">stock.picking.form.school.domain</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_detailed_operations']" position="replace"/>
            <xpath expr="//button[@name='do_print_picking']" position="replace"/>
            <xpath expr="//button[@name='207']" position="replace"/>
            <xpath expr="//field[@name='partner_id' and @nolabel='1']" position="attributes">
                <attribute name="domain">[('is_school', '=', picking_type_code == 'outgoing')]</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="replace">
                <field name="return_deadline_date"
                      invisible="picking_type_code != 'outgoing'"
                      readonly="state in ['cancel', 'done']"/>
                <field name="return_days_left"
                       invisible="picking_type_code != 'outgoing' or not return_deadline_date"
                       readonly="1"
                       decoration-danger="return_days_left &lt; 0"
                       decoration-warning="return_days_left == 0"
                       decoration-success="return_days_left &gt; 0"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_return_time" model="ir.ui.view">
        <field name="name">stock.picking.list.return.time</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="replace">
                <field name="return_deadline_date"
                       optional="show"
                       invisible="picking_type_code != 'outgoing'"/>
                <field name="return_days_left"
                       optional="show"
                       invisible="picking_type_code != 'outgoing'"
                       decoration-danger="return_days_left &lt; 0"
                       decoration-warning="return_days_left == 0"
                       decoration-success="return_days_left &gt; 0"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_return_time" model="ir.ui.view">
        <field name="name">stock.picking.search.return.time</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="return_deadline_date"/>
            </xpath>
            <xpath expr="//filter[@name='delivery']" position="after">
                <filter name="return_overdue"
                        string="Return Overdue"
                        domain="[('picking_type_code', '=', 'outgoing'), ('return_deadline_date', '&lt;', current_date)]"/>
                <filter name="return_due_today"
                        string="Return Due Today"
                        domain="[('picking_type_code', '=', 'outgoing'), ('return_deadline_date', '=', current_date)]"/>
            </xpath>
        </field>
    </record>


    <record id="view_dtp_school_class_search" model="ir.ui.view">
        <field name="name">res.partner.class.search</field>
        <field name="model">res.partner.class</field>
        <field name="arch" type="xml">
            <search string="Lop hoc">
                <field name="grade"/>
                <field name="class_count"/>
                <field name="school_id"/>
                <field name="region"/>
                <group>
                    <filter name="group_school" string="Truong" domain="[]" context="{'group_by': 'school_id'}"/>
                    <filter name="group_grade" string="Khoi lop" domain="[]" context="{'group_by': 'grade'}"/>
                    <filter name="group_region" string="Khu vuc" domain="[]" context="{'group_by': 'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dtp_school_class_list" model="ir.ui.view">
        <field name="name">res.partner.class.list</field>
        <field name="model">res.partner.class</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="grade"/>
                <field name="class_count"/>
                <field name="school_id"/>
                <field name="region"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_class_form" model="ir.ui.view">
        <field name="name">res.partner.class.form</field>
        <field name="model">res.partner.class</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="grade" readonly="1"/>
                        <field name="class_count" readonly="1"/>
                        <field name="school_id" readonly="1"/>
                        <field name="region" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Mon hoc">
                            <field name="subject_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="name"/>
                                    <field name="supply_product_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dtp_school_class" model="ir.actions.act_window">
        <field name="name">Lop hoc</field>
        <field name="res_model">res.partner.class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dtp_school_class_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="view_dtp_school_subject_search" model="ir.ui.view">
        <field name="name">res.partner.subject.search</field>
        <field name="model">res.partner.subject</field>
        <field name="arch" type="xml">
            <search string="Mon hoc">
                <field name="name"/>
                <field name="class_ids"/>
                <group>
                    <filter name="group_class" string="Khoi lop" domain="[]" context="{'group_by': 'class_ids'}"/>
                    <filter name="group_subject" string="Mon hoc" domain="[]" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dtp_school_subject_list" model="ir.ui.view">
        <field name="name">res.partner.subject.list</field>
        <field name="model">res.partner.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="class_ids" widget="many2many_tags"/>
                <field name="supply_product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_subject_form" model="ir.ui.view">
        <field name="name">res.partner.subject.form</field>
        <field name="model">res.partner.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="class_ids" widget="many2many_tags"/>
                        <field name="supply_product_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dtp_school_subject" model="ir.actions.act_window">
        <field name="name">Mon hoc</field>
        <field name="res_model">res.partner.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dtp_school_subject_search"/>
    </record>

</odoo>
