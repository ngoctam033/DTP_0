<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtp_school_list" model="ir.ui.view">
        <field name="name">dtp.school.list</field>
        <field name="model">dtp.school</field>
        <field name="arch" type="xml">
            <list string="Trường học">
                <field name="name"/>
                <field name="code"/>
                <field name="school_level"/>
                <field name="location_region"/>
                <field name="province_name"/>
                <field name="manager_name"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_form" model="ir.ui.view">
        <field name="name">dtp.school.form</field>
        <field name="model">dtp.school</field>
        <field name="arch" type="xml">
            <form string="Trường học">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="school_level"/>
                        </group>
                        <group>
                            <field name="manager_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="salesperson_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Khu vực trường học">
                        <group>
                            <field name="location_region"/>
                            <field name="province_name" placeholder="HCM: nhập quận, vùng khác: nhập tỉnh"/>
                        </group>
                        <group>
                            <field name="address_detail" placeholder="Địa chỉ cụ thể"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lớp học">
                            <field name="class_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="grade_id"/>
                                    <field name="homeroom_teacher"/>
                                    <field name="student_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_school_salesperson_list" model="ir.ui.view">
        <field name="name">dtp.school.salesperson.list</field>
        <field name="model">dtp.school.salesperson</field>
        <field name="arch" type="xml">
            <list string="Sale phụ trách">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_salesperson_form" model="ir.ui.view">
        <field name="name">dtp.school.salesperson.form</field>
        <field name="model">dtp.school.salesperson</field>
        <field name="arch" type="xml">
            <form string="Sale phụ trách">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_school_subject_list" model="ir.ui.view">
        <field name="name">dtp.school.subject.list</field>
        <field name="model">dtp.school.subject</field>
        <field name="arch" type="xml">
            <list string="Môn học">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_subject_form" model="ir.ui.view">
        <field name="name">dtp.school.subject.form</field>
        <field name="model">dtp.school.subject</field>
        <field name="arch" type="xml">
            <form string="Môn học">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Dụng cụ học tập">
                            <field name="equipment_line_ids">
                                <list editable="bottom">
                                    <field name="product_tmpl_id"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_school_class_list" model="ir.ui.view">
        <field name="name">dtp.school.class.list</field>
        <field name="model">dtp.school.class</field>
        <field name="arch" type="xml">
            <list string="Lớp học">
                <field name="name"/>
                <field name="school_id"/>
                <field name="school_level"/>
                <field name="grade_id"/>
                <field name="homeroom_teacher"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_class_form" model="ir.ui.view">
        <field name="name">dtp.school.class.form</field>
        <field name="model">dtp.school.class</field>
        <field name="arch" type="xml">
            <form string="Lớp học">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="school_id"/>
                            <field name="school_level" readonly="1"/>
                            <field name="grade_id"/>
                        </group>
                        <group>
                            <field name="homeroom_teacher"/>
                            <field name="student_count"/>
                            <field name="subject_ids" widget="many2many_tags"/>
                            <field name="toolkit_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dtp_school" model="ir.actions.act_window">
        <field name="name">Trường học</field>
        <field name="res_model">dtp.school</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtp_school_salesperson" model="ir.actions.act_window">
        <field name="name">Sale phụ trách</field>
        <field name="res_model">dtp.school.salesperson</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtp_school_subject" model="ir.actions.act_window">
        <field name="name">Môn học</field>
        <field name="res_model">dtp.school.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtp_school_class" model="ir.actions.act_window">
        <field name="name">Lớp học</field>
        <field name="res_model">dtp.school.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dtp_school_root" name="Quản lý trường học" parent="stock.menu_stock_root" sequence="30"/>
    <menuitem id="menu_dtp_school_school" name="Trường học" parent="menu_dtp_school_root" action="action_dtp_school" sequence="10"/>
    <menuitem id="menu_dtp_school_class" name="Lớp học" parent="menu_dtp_school_root" action="action_dtp_school_class" sequence="20"/>
    <menuitem id="menu_dtp_school_subject" name="Môn học" parent="menu_dtp_school_root" action="action_dtp_school_subject" sequence="30"/>
    <menuitem id="menu_dtp_school_salesperson" name="Sale phụ trách" parent="menu_dtp_school_root" action="action_dtp_school_salesperson" sequence="40"/>
</odoo>
