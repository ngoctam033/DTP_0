<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtp_delivery_order_list" model="ir.ui.view">
        <field name="name">dtp.delivery.order.list</field>
        <field name="model">dtp.delivery.order</field>
        <field name="arch" type="xml">
            <list string="Đơn giao hàng">
                <field name="name"/>
                <field name="delivery_date"/>
                <field name="school_id"/>
                <field name="class_id"/>
                <field name="salesperson_ids" widget="many2many_tags" optional="show"/>
                <field name="warehouse_id"/>
                <field name="carrier_name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_delivery_order_form" model="ir.ui.view">
        <field name="name">dtp.delivery.order.form</field>
        <field name="model">dtp.delivery.order</field>
        <field name="arch" type="xml">
            <form string="Đơn giao hàng">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận giao" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_picking" type="object" string="Xem phiếu xuất" invisible="not picking_id"/>
                    <button name="action_view_history" type="object" string="Lịch sử"/>
                    <button name="action_mark_delivered" type="object" string="Đánh dấu đã giao" invisible="state != 'in_transit'"/>
                    <button name="action_cancel" type="object" string="Hủy" invisible="state not in ('draft', 'in_transit')"/>
                    <button name="action_reset_draft" type="object" string="Về nháp" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_transit,delivered,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="school_id"/>
                            <field name="class_id"/>
                            <field name="salesperson_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="delivery_date"/>
                            <field name="warehouse_id"/>
                            <field name="carrier_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="total_qty" readonly="1"/>
                        <field name="picking_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Sản phẩm giao">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_return_order_list" model="ir.ui.view">
        <field name="name">dtp.return.order.list</field>
        <field name="model">dtp.return.order</field>
        <field name="arch" type="xml">
            <list string="Đơn thu hồi hàng">
                <field name="name"/>
                <field name="return_date"/>
                <field name="school_id"/>
                <field name="class_id"/>
                <field name="salesperson_ids" widget="many2many_tags" optional="show"/>
                <field name="warehouse_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_return_order_form" model="ir.ui.view">
        <field name="name">dtp.return.order.form</field>
        <field name="model">dtp.return.order</field>
        <field name="arch" type="xml">
            <form string="Đơn thu hồi hàng">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận thu hồi" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_picking" type="object" string="Xem phiếu nhập" invisible="not picking_id"/>
                    <button name="action_view_history" type="object" string="Lịch sử"/>
                    <button name="action_cancel" type="object" string="Hủy" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Về nháp" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,returned,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="school_id"/>
                            <field name="class_id"/>
                            <field name="salesperson_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="return_date"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="total_qty" readonly="1"/>
                        <field name="picking_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Sản phẩm thu hồi">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lý do">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_transfer_order_list" model="ir.ui.view">
        <field name="name">dtp.transfer.order.list</field>
        <field name="model">dtp.transfer.order</field>
        <field name="arch" type="xml">
            <list string="Đơn luân chuyển hàng">
                <field name="name"/>
                <field name="transfer_date"/>
                <field name="source_school_id"/>
                <field name="source_class_id"/>
                <field name="destination_school_id"/>
                <field name="destination_class_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_transfer_order_form" model="ir.ui.view">
        <field name="name">dtp.transfer.order.form</field>
        <field name="model">dtp.transfer.order</field>
        <field name="arch" type="xml">
            <form string="Đơn luân chuyển hàng">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận luân chuyển" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_history" type="object" string="Lịch sử"/>
                    <button name="action_cancel" type="object" string="Hủy" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Về nháp" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group string="Nguồn">
                            <field name="name"/>
                            <field name="source_school_id"/>
                            <field name="source_class_id"/>
                            <field name="salesperson_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group string="Đích đến">
                            <field name="transfer_date"/>
                            <field name="destination_school_id"/>
                            <field name="destination_class_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="total_qty" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Sản phẩm luân chuyển">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_product_history_search" model="ir.ui.view">
        <field name="name">dtp.product.history.search</field>
        <field name="model">dtp.product.history</field>
        <field name="arch" type="xml">
            <search string="Lịch sử hàng hóa">
                <field name="reference_name"/>
                <field name="school_id"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="source_school_id"/>
                <field name="destination_school_id"/>
                <filter name="filter_delivery" string="Giao hàng" domain="[('operation_type', '=', 'delivery')]"/>
                <filter name="filter_return" string="Thu hồi" domain="[('operation_type', '=', 'return')]"/>
                <filter name="filter_transfer" string="Luân chuyển" domain="[('operation_type', '=', 'transfer')]"/>
                <group>
                    <filter string="Theo trường" name="groupby_school" domain="[]" context="{'group_by': 'school_id'}"/>
                    <filter string="Theo sản phẩm" name="groupby_product" domain="[]" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dtp_product_history_list" model="ir.ui.view">
        <field name="name">dtp.product.history.list</field>
        <field name="model">dtp.product.history</field>
        <field name="arch" type="xml">
            <list string="Lịch sử hàng hóa">
                <field name="operation_date"/>
                <field name="operation_type"/>
                <field name="reference_name"/>
                <field name="school_id"/>
                <field name="class_id"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="quantity"/>
                <field name="quantity_delta"/>
                <field name="balance_qty"/>
                <field name="warehouse_id"/>
                <field name="source_school_id"/>
                <field name="destination_school_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_product_history_form" model="ir.ui.view">
        <field name="name">dtp.product.history.form</field>
        <field name="model">dtp.product.history</field>
        <field name="arch" type="xml">
            <form string="Lịch sử hàng hóa">
                <sheet>
                    <group>
                        <group>
                            <field name="operation_type"/>
                            <field name="operation_date"/>
                            <field name="reference_name"/>
                            <field name="product_id"/>
                            <field name="product_code"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="school_id"/>
                            <field name="class_id"/>
                            <field name="quantity_delta"/>
                            <field name="balance_qty"/>
                            <field name="warehouse_id"/>
                            <field name="source_school_id"/>
                            <field name="source_class_id"/>
                            <field name="destination_school_id"/>
                            <field name="destination_class_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtp_school_form_delivery_link" model="ir.ui.view">
        <field name="name">dtp.school.form.delivery.link</field>
        <field name="model">dtp.school</field>
        <field name="inherit_id" ref="dtp_school_management.view_dtp_school_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_view_delivery_orders" class="oe_stat_button" icon="fa-truck">
                        <field name="delivery_count" widget="statinfo" string="Giao hàng"/>
                    </button>
                    <button type="object" name="action_view_return_orders" class="oe_stat_button" icon="fa-undo">
                        <field name="return_count" widget="statinfo" string="Thu hồi"/>
                    </button>
                    <button type="object" name="action_view_transfer_orders" class="oe_stat_button" icon="fa-exchange">
                        <field name="transfer_count" widget="statinfo" string="Luân chuyển"/>
                    </button>
                    <button type="object" name="action_view_product_history" class="oe_stat_button" icon="fa-history">
                        <field name="history_count" widget="statinfo" string="Lịch sử thiết bị"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Đơn giao hàng">
                    <field name="delivery_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="delivery_date"/>
                            <field name="class_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
                <page string="Đơn thu hồi">
                    <field name="return_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="return_date"/>
                            <field name="class_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_dtp_school_product_track_list" model="ir.ui.view">
        <field name="name">dtp.school.product.track.list</field>
        <field name="model">dtp.school.product.track</field>
        <field name="arch" type="xml">
            <list string="Theo dõi cấp phát theo trường và sản phẩm">
                <field name="school_id"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="total_delivered"/>
                <field name="total_returned"/>
                <field name="total_transferred_in"/>
                <field name="total_transferred_out"/>
                <field name="qty_balance"/>
            </list>
        </field>
    </record>

    <record id="view_dtp_school_product_track_form" model="ir.ui.view">
        <field name="name">dtp.school.product.track.form</field>
        <field name="model">dtp.school.product.track</field>
        <field name="arch" type="xml">
            <form string="Theo dõi trường và sản phẩm">
                <sheet>
                    <group>
                        <group>
                            <field name="school_id"/>
                            <field name="product_id"/>
                            <field name="product_code"/>
                        </group>
                        <group>
                            <field name="total_delivered"/>
                            <field name="total_returned"/>
                            <field name="total_transferred_in"/>
                            <field name="total_transferred_out"/>
                            <field name="qty_balance"/>
                        </group>
                    </group>
                    <group>
                        <field name="history_ids" readonly="1">
                            <list>
                                <field name="operation_date"/>
                                <field name="operation_type"/>
                                <field name="reference_name"/>
                                <field name="quantity_delta"/>
                                <field name="balance_qty"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_picking_form_dtp_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.dtp.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="dtp_delivery_order_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="action_dtp_delivery_order" model="ir.actions.act_window">
        <field name="name">Đơn giao hàng</field>
        <field name="res_model">dtp.delivery.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtp_return_order" model="ir.actions.act_window">
        <field name="name">Thu hồi hàng</field>
        <field name="res_model">dtp.return.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtp_transfer_order" model="ir.actions.act_window">
        <field name="name">Luân chuyển hàng</field>
        <field name="res_model">dtp.transfer.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dtp_product_history" model="ir.actions.act_window">
        <field name="name">Lịch sử hàng hóa</field>
        <field name="res_model">dtp.product.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dtp_product_history_search"/>
    </record>

    <record id="action_dtp_school_product_track" model="ir.actions.act_window">
        <field name="name">Theo dõi theo trường &amp; sản phẩm</field>
        <field name="res_model">dtp.school.product.track</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dtp_delivery_root" name="Điều phối hàng hóa" parent="stock.menu_stock_root" sequence="40"/>
    <menuitem id="menu_dtp_delivery_order" name="Đơn giao hàng" parent="menu_dtp_delivery_root" action="action_dtp_delivery_order" sequence="10"/>
    <menuitem id="menu_dtp_return_order" name="Thu hồi hàng" parent="menu_dtp_delivery_root" action="action_dtp_return_order" sequence="20"/>
    <menuitem id="menu_dtp_transfer_order" name="Luân chuyển hàng" parent="menu_dtp_delivery_root" action="action_dtp_transfer_order" sequence="30"/>
    <menuitem id="menu_dtp_product_history" name="Lịch sử hàng hóa" parent="menu_dtp_delivery_root" action="action_dtp_product_history" sequence="40"/>
    <menuitem id="menu_dtp_school_product_track" name="Theo dõi trường &amp; sản phẩm" parent="menu_dtp_delivery_root" action="action_dtp_school_product_track" sequence="50"/>
</odoo>
